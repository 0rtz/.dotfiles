{
	"wireplumber": {
		"format": "{icon} {volume}%",
		"format-muted": "",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format-icons": ["", "", ""]
	},

	"clock": {
		"format": "{:%H:%M}",
		"format-alt": "{:%a, %d. %b  %H:%M}",
		"on-click-right": "alacritty --command bash -c 'khal interactive'"
	},

	"hyprland/workspaces": {
		"format": "{windows}",
		"window-rewrite-default": "",
		"window-rewrite": {
			"class<Alacritty>": "",
			"class<bitwarden>": "󰌆",
			"class<firefox>": "󰈹",
			"class<firefox> title<.*github.*>": "",
			"class<gthumb>": "󰋩",
			"class<jetbrains-clion>": "",
			"class<jetbrains-pycharm>": "",
			"class<jetbrains-webstorm>": "",
			"class<mpv>": "",
			"class<org.gnome.Nautilus>": "",
			"class<neovide>": "",
			"class<Brave-browser>": "",
			"class<org.getmonero.monero-wallet-gui>": "󰖄",
			"class<org.kde.okular>": "",
			"class<qemu>": "",
			"class<remote-viewer>": "",
			"class<spicy>": "",
			"class<resources_monitor>": "",
			"class<Tor Browser>": "",
			"class<com.github.xournalpp.xournalpp>": "󰏪",
			"class<code>": "",
			"class<windsurf>": "",
			"class<thunderbird>": "",
			"class<monero-core>": "",
			"class<vesktop>": "",
		}
	},
	// NOTE: "hyprland/language" module does not pick up XKB group for russian layout switched to via grp:caps_toggle
	"custom/keyboard-layout": {
		"exec": "~/.config/waybar/scripts/keyboard-layout.sh",
		"interval": 1,
		"tooltip": false
	},

	// Get class of applications: swaymsg -t get_tree
	"sway/workspaces": {
		"format": "{windows}",
		"format-window-separator": " ",
		"window-rewrite-default": "{name}",
		"window-format": "{name}",
		"window-rewrite": {
			"class<Alacritty>": "",
			"class<bitwarden>": "󰌆",
			"class<firefox>": "󰈹",
			"class<firefox> title<.*github.*>": "",
			"class<gthumb>": "󰋩",
			"class<jetbrains-clion>": "",
			"class<jetbrains-pycharm>": "",
			"class<jetbrains-webstorm>": "",
			"class<mpv>": "",
			"class<org.gnome.Nautilus>": "",
			"class<neovide>": "",
			"class<Brave-browser>": "",
			"class<org.getmonero.monero-wallet-gui>": "󰖄",
			"class<org.kde.okular>": "",
			"class<qemu>": "",
			"class<remote-viewer>": "",
			"class<spicy>": "",
			"class<resources_monitor>": "",
			"class<Tor Browser>": "",
			"class<com.github.xournalpp.xournalpp>": "󰏪",
			"class<code>": "",
			"class<windsurf>": "",
			"class<thunderbird>": "",
			"class<monero-core>": "",
			"class<vesktop>": "",
		},
		"disable-scroll": true
	},
	"sway/language": {
		"format": "{flag}"
	}
}