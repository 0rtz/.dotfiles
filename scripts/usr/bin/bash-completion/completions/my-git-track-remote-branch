# shellcheck shell=bash
_my_git_track_remote_branch() {
	local cur="${COMP_WORDS[COMP_CWORD]}"

	if (( COMP_CWORD == 1 )); then
		COMPREPLY=($(compgen -W "$(git branch --remotes --format='%(refname:short)' 2>/dev/null)" -- "$cur"))
	fi
}
complete -F _my_git_track_remote_branch my-git-track-remote-branch
