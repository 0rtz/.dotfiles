#!/bin/bash
set -euo pipefail
# Quick HTTP status check with colorized output
source "$HOME/usr/bin/my-scripts-lib/init.sh"

if [[ -z "${1:-}" ]]; then
	echo "Usage: my-http-status <url> [url...]"
	exit 1
fi

require_cmd curl

for url in "$@"; do
	# Prepend https:// if no scheme
	[[ "$url" =~ ^https?:// ]] || url="https://$url"

	status=$(curl -sI --max-time 10 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null) || status="000"

	# Colorize by status range
	case "$status" in
		2??) color="\033[1;32m" ;;  # green
		3??) color="\033[1;33m" ;;  # yellow
		4??) color="\033[1;31m" ;;  # red
		5??) color="\033[1;35m" ;;  # magenta
		*)   color="\033[1;90m" ;;  # gray
	esac

	printf "${color}%s\033[0m  %s\n" "$status" "$url"
done
