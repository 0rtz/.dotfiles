#!/bin/bash
# shellcheck disable=SC2154  # _my_pkg_manager set by detect_pkg_manager()
set -euo pipefail
# Show package dependency tree
# shellcheck source=../../../my-scripts-lib/init.sh disable=SC2154
source "$HOME/usr/bin/my-scripts-lib/init.sh"
detect_pkg_manager || exit 1

package="$1"

if [[ -z "$package" ]] && command -v fzf &>/dev/null; then
	package=$(packages_list_names | fzf --prompt "Package> ") || exit
fi

[[ -z "$package" ]] && exit 1

case "$_my_pkg_manager" in
	pacman)
		if ! command -v pactree &>/dev/null; then
			echo "ERROR: pactree required (pacman-contrib)" >&2
			exit 1
		fi
		pactree -c "$package"
		;;
	apt)
		apt-cache depends "$package"
		;;
	dnf)
		dnf repoquery --requires "$package"
		;;
	zypper)
		zypper info --requires "$package"
		;;
esac
