// https://zellij.dev/documentation/configuration.html

// Used for opening new tabs when shell is not specified
default_shell "fish"

// Zellij buffer size
scroll_buffer_size 10000

// Wayland: "wl-copy"
// X11: "xclip -selection clipboard"
// macOS: "pbcopy"
copy_command "wl-copy"

// ~/.config/zellij/themes/catppuccin-mocha-custom.kdl
theme "catppuccin-mocha-custom"

// ~/.config/zellij/layouts/default.kdl
default_layout "default"

ui {
    pane_frames {
        rounded_corners true
    }
}
// Hide hints at pane frames on mouse hover
advanced_mouse_actions false
mouse_hover_effects false

// Copy text selected with mouse
copy_on_select true

// Clean startup experience
show_startup_tips false
show_release_notes false

// Sessions persistence
session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 0
// Save session every 60 seconds
serialization_interval 60
// Always launch yazi in the resurrected working directory
// (run as a shell's child process to preserve working directory)
post_command_discovery_hook "echo \"bash -c 'yazi'\""

plugins {
    // Status bar: https://github.com/dj95/zjstatus
    // NOTE: when changing zjstatus configuration delete sessions using old config
    zjstatus-bar location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
        // https://github.com/catppuccin/zellij/blob/main/catppuccin.kdl
        // NOTE: `$dark` substituted for `#181825`
        color_dark    "#181825"
        color_red     "#f38ba8"
        color_blue    "#89b4fa"
        color_green   "#a6e3a1"
        color_default "#cdd6f4"

        format_left   "{mode} #[fg=$default,bold]{session}   {tabs}"
        format_center ""
        format_right  "{command_usage}"
        format_space  ""

        mode_normal "#[bg=$red] "
        mode_tmux   "#[bg=$blue] "
        mode_tab    "#[fg=$dark,bg=$blue,bold][TAB]"
        mode_rename_pane    "#[fg=$dark,bg=$blue,bold][RENAMEPANE]"
        mode_rename_tab    "#[fg=$dark,bg=$blue,bold][RENAMETAB]"
        mode_resize    "#[fg=$dark,bg=$blue,bold][RESIZE]"
        mode_scroll    "#[fg=$dark,bg=$blue,bold][SCROLL]"
        mode_enter_search    "#[fg=$dark,bg=$blue,bold][ENTERSEARCH]"
        mode_search    "#[fg=$dark,bg=$blue,bold][SEARCH]"

        tab_sync_indicator       "S"
        tab_fullscreen_indicator "󰊓"
        tab_floating_indicator   "⬚"
        tab_normal   "#[fg=$default]{name}  "
        tab_normal_fullscreen "#[fg=$default]{fullscreen_indicator}{name}  "
        tab_normal_sync "#[fg=$green,bold,italic]{sync_indicator}#[fg=$default]{name}  "
        tab_active   "#[fg=$red,bold,italic]{name}  "
        tab_active_fullscreen "#[fg=$red,bold,italic]{fullscreen_indicator}{name}  "
        tab_active_sync "#[fg=$green,bold,italic]{sync_indicator}#[fg=$red,bold,italic]{name}  "

        command_usage_command  "bash -c \"~/.config/zellij/scripts/system_usage.sh\""
        command_usage_format   "{stdout}"
        command_usage_rendermode "dynamic"
        command_usage_interval "2"
    }
}

// https://zellij.dev/documentation/keybindings-possible-actions.html
keybinds clear-defaults=true {
    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    tmux {
        bind "Esc" "q" "Ctrl c" { SwitchToMode "Normal"; }

        // Send Ctrl-a to the terminal
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Panes
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Shift h" { MovePane "Left"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Shift l" { MovePane "Right"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "Shift k" { MovePane "Up"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Shift j" { MovePane "Down"; SwitchToMode "Normal"; }
        bind "b" {
            // Launch through shell to make yazi correctly inherit original pane's cwd
            Run "bash" "-c" "'yazi'" {
                direction "Right"
            };

            SwitchToMode "Normal";
        }
        bind "v" {
            Run "bash" "-c" "'yazi'" {
                direction "Down"
            };
            SwitchToMode "Normal";
        }
        bind "n" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "o" { NewPane; SwitchToMode "Normal"; }
        bind "Shift r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "g" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "." { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind ">" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "Ctrl r" { SwitchToMode "Resize"; }

        // Tabs
        bind "a" { ToggleTab; SwitchToMode "Normal"; }
        bind "t" { NewTab; SwitchToMode "Normal"; }
        bind "Ctrl t" { SwitchToMode "Tab"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Shift x" { CloseTab; SwitchToMode "Normal"; }

        // Clear zellij buffer
        bind "Ctrl l" { Clear; SwitchToMode "Normal"; }
        // Edit zellij buffer in $EDITOR
        bind "s" "f" { EditScrollback { ansi true; }; SwitchToMode "Normal"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl d" "d" { SwitchToMode "Scroll"; }

        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "zellij:plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl a" "Esc" "Ctrl c" { UndoRenamePane; SwitchToMode "Normal"; }
    }
    // Resize panes
    // Can also resize by dragging border with mouse (for pinned window ctrl+dragging)
    resize {
        bind "Ctrl a" "q" "Esc"  "Ctrl c" "Ctrl r" { SwitchToMode "Normal"; }

        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
    }

    tab {
        bind "Ctrl a" "Enter" "Esc" "q" "Ctrl c" { SwitchToMode "Normal"; }

        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "Shift h" { MoveTab "Left"; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "Shift l" { MoveTab "Right"; }
        bind "x" { CloseTab; }

        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl a" "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    // Scroll zellij buffer
    scroll {
        bind "Ctrl a" "q" "Esc" "Ctrl c" { SwitchToMode "Normal"; }

        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }

        bind "j" "Ctrl e" "Down" { ScrollDown; }
        bind "k" "Ctrl y" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "g" { ScrollToTop; }

        bind "s" "f" { EditScrollback { ansi true; }; SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Ctrl a" { SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    search {
        bind "Ctrl a" "Ctrl c" "q" "Esc" { SwitchToMode "Normal"; }

        bind "n" { Search "up"; }
        bind "N" { Search "down"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }

        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "g" { ScrollToTop; }

        bind "s" "f" { EditScrollback { ansi true; }; SwitchToMode "Normal"; }
    }
}