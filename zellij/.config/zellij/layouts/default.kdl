layout {
    swap_tiled_layout name="vertical" {
        tab {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
            pane size=1 borderless=true {
                plugin location="zjstatus-bar"
            }
        }
    }

    // Yazi uses exec when dropping to shell
    pane command="bash" start_suspended=false close_on_exit=true {
        args "-c" "yazi"
    }
    pane size=1 borderless=true {
        plugin location="zjstatus-bar"
    }
}
